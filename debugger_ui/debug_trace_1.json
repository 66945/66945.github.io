{
    "sources": {
        "_get_data": [
            "    def _get_data(self, date_range: Interval = None, **chunk) -> list[dict]:",
            "        if not self._table:",
            "            raise NotImplementedError('execution halted because no response schema was provided. the cell can be overwritten via the metadata class. run once you have validated that the class has been built appropriately')",
            "",
            "        records       = []",
            "        has_next_page = True",
            "",
            "        current_page = self._page_start",
            "",
            "        while has_next_page:",
            "            if self._pagination_method != None:",
            "                my_logger.info('getting page ...')",
            "",
            "            format_dict = {",
            "                **chunk,",
            "                'page_size': self._page_size,",
            "            }",
            "",
            "            if date_range:",
            "                format_dict.update({",
            "                    'start_date': date_range.start_date,",
            "                    'end_date':   date_range.end_date,",
            "                })",
            "",
            "            if self._pagination_method:",
            "                format_dict['page'] = current_page",
            "",
            "            formatted_url  = self._request_url.format(**format_dict)",
            "            formatted_body = self._request_body.format(**format_dict)",
            "",
            "            formatted_params = {",
            "                key: value.format(**format_dict)",
            "                for key, value in self._request_params.items()",
            "                    if value.format(**format_dict)",
            "            }",
            "            formatted_headers = {",
            "                key: value.format(**format_dict)",
            "                for key, value in self._request_headers.items()",
            "                    if value.format(**format_dict)",
            "            }",
            "",
            "            response = self._connection.get_response_data(",
            "                chunk['tenant'],",
            "                self._request_method,",
            "                formatted_url,",
            "                formatted_params,",
            "                formatted_headers,",
            "                formatted_body,",
            "                self._response_type,",
            "            )",
            "",
            "            Parameter.set_params(format_dict)",
            "",
            "            # handle exports with bfs",
            "            # TODO: simplify, this is chaotic",
            "            exports = self._table.get_exports(response, format_dict)",
            "            queue   = [([], exports)]",
            "            while queue:",
            "                path, export_dict = queue.pop()",
            "",
            "                for name, value in dict(export_dict).items():",
            "                    if type(value) == list:",
            "                        export_to = self._exports",
            "                        for p in path:",
            "                            if p not in export_to:",
            "                                export_to[p] = {}",
            "                            export_to = export_to[p]",
            "                        if name not in export_to:",
            "                            export_to[name] = []",
            "                        export_to[name].extend(value)",
            "                    else:",
            "                        queue.insert(0, ([*path, name], value))",
            "",
            "            self._table.add_blue_margin_fields(response, format_dict)",
            "            self._table.perform_executions(response, format_dict)",
            "",
            "            if type(response) == list:",
            "                records.extend(response)",
            "            else:",
            "                records.append(response)",
            "",
            "            if self._pagination_method != None:",
            "                next_page     = self._table.get_next_page(response, format_dict)",
            "                has_next_page = bool(next_page)",
            "",
            "                match self._pagination_method:",
            "                    case 'page':",
            "                        current_page += 1",
            "                    case 'offset':",
            "                        current_page += self._page_size",
            "                    case 'cursor':",
            "                        current_page = next_page",
            "            else:",
            "                has_next_page = False",
            "",
            "            Parameter.clear_params()",
            "",
            "        return records",
            ""
        ],
        "info": [
            "    def info(self, msg, *args, **kwargs):",
            "        \"\"\"",
            "        Log 'msg % args' with severity 'INFO'.",
            "",
            "        To pass exception information, use the keyword argument exc_info with",
            "        a true value, e.g.",
            "",
            "        logger.info(\"Houston, we have a %s\", \"interesting problem\", exc_info=1)",
            "        \"\"\"",
            "        if self.isEnabledFor(INFO):",
            "            self._log(INFO, msg, args, **kwargs)",
            ""
        ],
        "isEnabledFor": [
            "    def isEnabledFor(self, level):",
            "        \"\"\"",
            "        Is this logger enabled for level 'level'?",
            "        \"\"\"",
            "        if self.disabled:",
            "            return False",
            "",
            "        try:",
            "            return self._cache[level]",
            "        except KeyError:",
            "            _acquireLock()",
            "            try:",
            "                if self.manager.disable >= level:",
            "                    is_enabled = self._cache[level] = False",
            "                else:",
            "                    is_enabled = self._cache[level] = (",
            "                        level >= self.getEffectiveLevel()",
            "                    )",
            "            finally:",
            "                _releaseLock()",
            "            return is_enabled",
            ""
        ],
        "_log": [
            "    def _log(self, level, msg, args, exc_info=None, extra=None, stack_info=False,",
            "             stacklevel=1):",
            "        \"\"\"",
            "        Low-level logging routine which creates a LogRecord and then calls",
            "        all the handlers of this logger to handle the record.",
            "        \"\"\"",
            "        sinfo = None",
            "        if _srcfile:",
            "            #IronPython doesn't track Python frames, so findCaller raises an",
            "            #exception on some versions of IronPython. We trap it here so that",
            "            #IronPython can use logging.",
            "            try:",
            "                fn, lno, func, sinfo = self.findCaller(stack_info, stacklevel)",
            "            except ValueError: # pragma: no cover",
            "                fn, lno, func = \"(unknown file)\", 0, \"(unknown function)\"",
            "        else: # pragma: no cover",
            "            fn, lno, func = \"(unknown file)\", 0, \"(unknown function)\"",
            "        if exc_info:",
            "            if isinstance(exc_info, BaseException):",
            "                exc_info = (type(exc_info), exc_info, exc_info.__traceback__)",
            "            elif not isinstance(exc_info, tuple):",
            "                exc_info = sys.exc_info()",
            "        record = self.makeRecord(self.name, level, fn, lno, msg, args,",
            "                                 exc_info, func, extra, sinfo)",
            "        self.handle(record)",
            ""
        ],
        "findCaller": [
            "    def findCaller(self, stack_info=False, stacklevel=1):",
            "        \"\"\"",
            "        Find the stack frame of the caller so that we can note the source",
            "        file name, line number and function name.",
            "        \"\"\"",
            "        f = currentframe()",
            "        #On some versions of IronPython, currentframe() returns None if",
            "        #IronPython isn't run with -X:Frames.",
            "        if f is None:",
            "            return \"(unknown file)\", 0, \"(unknown function)\", None",
            "        while stacklevel > 0:",
            "            next_f = f.f_back",
            "            if next_f is None:",
            "                ## We've got options here.",
            "                ## If we want to use the last (deepest) frame:",
            "                break",
            "                ## If we want to mimic the warnings module:",
            "                #return (\"sys\", 1, \"(unknown function)\", None)",
            "                ## If we want to be pedantic:",
            "                #raise ValueError(\"call stack is not deep enough\")",
            "            f = next_f",
            "            if not _is_internal_frame(f):",
            "                stacklevel -= 1",
            "        co = f.f_code",
            "        sinfo = None",
            "        if stack_info:",
            "            with io.StringIO() as sio:",
            "                sio.write(\"Stack (most recent call last):\\n\")",
            "                traceback.print_stack(f, file=sio)",
            "                sinfo = sio.getvalue()",
            "                if sinfo[-1] == '\\n':",
            "                    sinfo = sinfo[:-1]",
            "        return co.co_filename, f.f_lineno, co.co_name, sinfo",
            ""
        ],
        "<lambda>": [
            "    currentframe = lambda: sys._getframe(1)",
            ""
        ],
        "_is_internal_frame": [
            "def _is_internal_frame(frame):",
            "    \"\"\"Signal whether the frame is a CPython or logging module internal.\"\"\"",
            "    filename = os.path.normcase(frame.f_code.co_filename)",
            "    return filename == _srcfile or (",
            "        \"importlib\" in filename and \"_bootstrap\" in filename",
            "    )",
            ""
        ]
    },
