{"sources": {"_get_data": ["    def _get_data(self, date_range: Interval = None, **chunk) -> list[dict]:", "        if not self._table:", "            raise NotImplementedError('execution halted because no response schema was provided. the cell can be overwritten via the metadata class. run once you have validated that the class has been built appropriately')", "", "        records       = []", "        has_next_page = True", "", "        current_page = self._page_start", "", "        while has_next_page:", "            if self._pagination_method != None:", "                my_logger.info('getting page ...')", "", "            format_dict = {", "                **chunk,", "                'page_size': self._page_size,", "            }", "", "            if date_range:", "                format_dict.update({", "                    'start_date': date_range.start_date,", "                    'end_date':   date_range.end_date,", "                })", "", "            if self._pagination_method:", "                format_dict['page'] = current_page", "", "            formatted_url  = self._request_url.format(**format_dict)", "            formatted_body = self._request_body.format(**format_dict)", "", "            formatted_params = {", "                key: value.format(**format_dict)", "                for key, value in self._request_params.items()", "                    if value.format(**format_dict)", "            }", "            formatted_headers = {", "                key: value.format(**format_dict)", "                for key, value in self._request_headers.items()", "                    if value.format(**format_dict)", "            }", "", "            response = self._connection.get_response_data(", "                chunk['tenant'],", "                self._request_method,", "                formatted_url,", "                formatted_params,", "                formatted_headers,", "                formatted_body,", "                self._response_type,", "            )", "", "            Parameter.set_params(format_dict)", "", "            # handle exports with bfs", "            # TODO: simplify, this is chaotic", "            # FIXME: a debug export would have me believe that I export the ids twice - worth checking over", "            # to see why. Could lead to serious performance improvements", "            exports = self._table.get_exports(response, format_dict)", "            queue   = [([], exports)]", "            while queue:", "                path, export_dict = queue.pop()", "", "                for name, value in dict(export_dict).items():", "                    if type(value) == list:", "                        export_to = self._exports", "                        for p in path:", "                            if p not in export_to:", "                                export_to[p] = {}", "                            export_to = export_to[p]", "                        if name not in export_to:", "                            export_to[name] = []", "                        export_to[name].extend(value)", "                    else:", "                        queue.insert(0, ([*path, name], value))", "", "            self._table.add_blue_margin_fields(response, format_dict)", "            self._table.perform_executions(response, format_dict)", "", "            if type(response) == list:", "                records.extend(response)", "            else:", "                records.append(response)", "", "            if self._pagination_method != None:", "                next_page     = self._table.get_next_page(response, format_dict)", "                has_next_page = bool(next_page)", "", "                match self._pagination_method:", "                    case 'page':", "                        current_page += 1", "                    case 'offset':", "                        current_page += self._page_size", "                    case 'cursor':", "                        current_page = next_page", "            else:", "                has_next_page = False", "", "            Parameter.clear_params()", "", "        return records", ""]}, "trace": [["_get_data", 1, {"self": "<__main__.PatientSkillAcqPrograms object at 0x79ab8161db10>", "date_range": "None", "chunk": "{'snaps': 'daily', 'workers': 5, 'patient_id': 141, 'tenant': 'amegodata'}"}, 1], ["_get_data", 2, {"self": "<__main__.PatientSkillAcqPrograms object at 0x79ab8161db10>", "date_range": "None", "chunk": "{'snaps': 'daily', 'workers': 5, 'patient_id': 141, 'tenant': 'amegodata'}"}, 1]]}